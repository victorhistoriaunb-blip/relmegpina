# ---------------------------------------------------------------------------
# RELMEG — variáveis de ambiente (referência)
# ---------------------------------------------------------------------------
# Frontend (React/Vite): copie para frontend/.env e preencha com valores reais.
# Use SEMPRE apenas a chave publishable/anônima do Supabase no frontend.
# NUNCA coloque a service role key em variáveis VITE_* (vazaria para o bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:8001

# Backend (FastAPI): definidas somente no servidor. A service role key fica
# restrita ao back-end/SSR e nunca chega ao navegador.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# CORS extra do backend (lista separada por vírgula), além das origens fixas
# (local:5173 e https://relmegpina.vercel.app).
# RELMEG_CORS_ORIGINS=https://variante.exemplo.com.br

# Segurança de superfície: header X-API-Key obrigatório em TODAS as rotas
# (exceto /, /docs, /redoc, /openapi.json e preflight OPTIONS). Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Se vazia, a API fica aberta (apenas ambiente localhost). Nunca deixe vazia
# ao expor via ngrok/túnel reverso.
# RELMEG_API_KEY=

# Nível de log do loguru (INFO recomendado em produção; DEBUG para depuração).
# RELMEG_LOG_LEVEL=INFO

# Pasta de entregas substituta (default: ~/Desktop/RelMeg - Entregas).
# DIR_ENTREGAS=C:\Caminho\Para\Entregas

# Rate limiting (slowapi): N=quantidade, S=segundos/M=minutos/H=horas.
# RATELIMIT_DEFAULT=120/minute
# RATELIMIT_ENABLED=true